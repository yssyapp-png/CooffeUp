PORT=4000
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development

# Moyasar (https://dashboard.moyasar.com → Settings → API Keys)
# Use sk_test_/pk_test_ keys until go-live. The secret key must stay on the server.
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
# Same value as the "Secret Token" set on the webhook in the Moyasar dashboard
MOYASAR_WEBHOOK_SECRET=
# Public URL of the web app; Moyasar redirects to <PUBLIC_WEB_URL>/payment/callback
PUBLIC_WEB_URL=http://localhost:5173

# Skyline: paid orders are pushed here
SKYLINE_API_URL=
SKYLINE_API_KEY=
SKYLINE_ORDERS_PATH=/orders
SKYLINE_BRANCH_ID=
