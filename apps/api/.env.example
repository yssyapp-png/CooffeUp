PORT=4000
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
# Public URL used in invoice links sent by SMS and in webhook URLs shown to integrations.
PUBLIC_BASE_URL=http://localhost:4000

# Required in production. Generate with: openssl rand -base64 48 / openssl rand -base64 32
# AUTH_SECRET=
# DATA_ENCRYPTION_KEY=

# Seller details printed on invoices and encoded in the ZATCA QR.
SELLER_NAME=CooffeUp
SELLER_VAT=300000000000003
# cafe | restaurant | retail | salon | clinic | laundry
BUSINESS_TYPE=cafe

# Demo staff (PINs 1111 owner, 2222 manager, 3333 cashier, 4444 kitchen, 5555 accountant). Always off in production.
SEED_DEMO_DATA=true
# First owner PIN when demo data is off.
# OWNER_PIN=

# SMS: "log" keeps messages in the app only; "http" posts {to, sender, message} to your gateway.
SMS_PROVIDER=log
# SMS_HTTP_URL=
# SMS_HTTP_TOKEN=
SMS_SENDER=CooffeUp
